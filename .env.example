# TMDB API Key (Required)
# Get your free key at https://www.themoviedb.org/settings/api
REACT_APP_API_KEY=your_tmdb_api_key_here

# Streaming servers (optional, defaults are used if not provided)
REACT_APP_MOVIE_SERVER1=https://vidsrc.to/embed/movie/
REACT_APP_TV_SERVER1=https://vidsrc.to/embed/tv/
